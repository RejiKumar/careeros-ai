# CareerOS Mobile — public configuration reference (dev/qa/prod)
# Only EXPO_PUBLIC_* values are embedded in the app binary.
# NEVER place service-role keys, purchase secrets or provider keys here.
#
# LOCAL DEVELOPMENT:
#   .env is loaded automatically for local runs (npx expo start / expo prebuild).
#   API_URL should be http://localhost:8000 (use adb reverse for device).
#
# EAS BUILDS:
#   eas.json injects EXPO_PUBLIC_API_URL per build profile — do NOT hardcode
#   QA/Prod URLs in .env. The EAS env block overrides .env values.
#
# ENVIRONMENT ARCHITECTURE:
#   DEV  → Android adb reverse → localhost:8000 (EXPO_PUBLIC_API_URL in .env)
#   PROD/device-test → eas.json:build.<profile>.env embeds EXPO_PUBLIC_API_URL
#   EAS builds read the profile's env block; the resolver in src/config/api-origin.ts
#   rejects loopback/relative origins for externally distributed (prod) profiles.
#   The deployed origin is recorded in eas.json once the API is deployed.

# App flavor: dev | prod (qa is not distributed by a build profile)
EXPO_PUBLIC_APP_ENV=dev

# Public API base URL (local dev only — EAS overrides per profile)
# Local: http://localhost:8000 via adb reverse. Never use this value for prod.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Public Supabase configuration (anon key is public)
EXPO_PUBLIC_SUPABASE_URL=https://puxnptidnwdhjpzjrjrp.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public AdMob app ids and ad unit ids (public configuration embedded in the binary).
# Replace with production IDs before Play Store release.
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID_IOS=ca-app-pub-3940256099942544/4411468910
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/5224354917
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID_IOS=ca-app-pub-3940256099942544/1712485313

# Legal page URLs (injected by EAS production profile)
EXPO_PUBLIC_PRIVACY_URL=https://careerosai.app/privacy
EXPO_PUBLIC_TERMS_URL=https://careerosai.app/terms
EXPO_PUBLIC_SUPPORT_URL=https://careerosai.app/support
