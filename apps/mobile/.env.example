# CareerOS Mobile — public configuration reference (dev/qa/prod)
# Copy to .env for local runs. Only EXPO_PUBLIC_* values are embedded in the app.
# NEVER place service-role keys, purchase secrets or provider keys here.

# App flavor: dev | qa | prod
EXPO_PUBLIC_APP_ENV=dev

# Public API base URL
EXPO_PUBLIC_API_URL=http://localhost:8000

# Public Supabase configuration (anon key is public)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public AdMob app ids and ad unit ids (public configuration embedded in the binary).
# Android test app id: ca-app-pub-3940256099942544~3347511713
# Android test banner: ca-app-pub-3940256099942544/6300978111
# iOS test app id:     ca-app-pub-3940256099942544~1458002511
# iOS test banner:     ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=
EXPO_PUBLIC_ADMOB_APP_ID_IOS=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=
EXPO_PUBLIC_ADMOB_TEST_BANNER_UNIT_ID=ca-app-pub-3940256099942544/9214589741
