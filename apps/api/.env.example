# CareerOS API environment reference (dev/qa/prod)
# Copy to .env for local runs. NEVER commit real values.
# Public configuration only; service-role keys must never appear here.

# Environment profile: dev | qa | prod
CAREEROS_ENVIRONMENT=dev

# Logging
CAREEROS_LOG_LEVEL=INFO

# CORS origins allowed to call the API (comma-separated). Dev defaults:
CAREEROS_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Public Supabase configuration (anon key is public, but leave empty until provisioned)
CAREEROS_SUPABASE_URL=
CAREEROS_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, never in mobile code or Git.
# Leave empty until provisioned.
CAREEROS_SUPABASE_SERVICE_ROLE_KEY=

# Supabase project database password — SERVER ONLY, used by migrations/admin tooling.
# Leave empty until provisioned.
CAREEROS_SUPABASE_DB_PASSWORD=

# AI provider configuration (Gemini) — SERVER ONLY.
# Model must be a canonical generativelanguage model id (e.g. gemini-3.5-flash-lite).
CAREEROS_GEMINI_API_KEY=
CAREEROS_GEMINI_MODEL=
# Used when the primary model keeps returning 429/5xx. Leave empty to disable.
CAREEROS_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Daily AI actions per rolling 24 hours (resume import, scores, matches, coach,
# interview, tailor, ...). 0 disables the limit for that audience; Pro is unlimited.
# Requires the ai_usage_events migration (supabase/migrations/*_ai_usage_events.sql).
CAREEROS_AI_DAILY_LIMIT_GUEST=3
CAREEROS_AI_DAILY_LIMIT_USER=20

# Real-time job search via JSearch (Google for Jobs) on RapidAPI — SERVER ONLY.
# Subscribe at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch (free plan
# has a small hard monthly cap). Tried first; Adzuna is used when it fails or
# its quota is exhausted. Country is an ISO 3166-1 alpha-2 code.
CAREEROS_JSEARCH_API_KEY=
CAREEROS_JSEARCH_COUNTRY=in

# Adzuna job search API — SERVER ONLY. Obtain app_id/app_key from
# https://developer.adzuna.com. Fallback for JSearch, or the only provider when
# JSearch is unset. When both are unset, job search returns sample results.
CAREEROS_ADZUNA_APP_ID=
CAREEROS_ADZUNA_APP_KEY=
CAREEROS_ADZUNA_COUNTRY=in

# Reminder scheduling. Keep the in-process scheduler on for always-on hosts.
# On scale-to-zero hosts (Cloud Run) set it to false and have an external
# scheduler POST /api/v1/jobs/notification-reminders with header
# X-Cron-Secret: <CAREEROS_CRON_SECRET>. SERVER ONLY; empty disables the endpoint.
CAREEROS_IN_PROCESS_SCHEDULER=true
CAREEROS_CRON_SECRET=
