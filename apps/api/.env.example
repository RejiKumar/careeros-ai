# CareerOS API environment reference (dev/qa/prod)
# Copy to .env for local runs. NEVER commit real values.
# Public configuration only; service-role keys must never appear here.

# Environment profile: dev | qa | prod
CAREEROS_ENVIRONMENT=dev

# Logging
CAREEROS_LOG_LEVEL=INFO

# CORS origins allowed to call the API (comma-separated). Dev defaults:
CAREEROS_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Public Supabase configuration (anon key is public, but leave empty until provisioned)
CAREEROS_SUPABASE_URL=
CAREEROS_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, never in mobile code or Git.
# Leave empty until provisioned.
CAREEROS_SUPABASE_SERVICE_ROLE_KEY=

# Supabase project database password — SERVER ONLY, used by migrations/admin tooling.
# Leave empty until provisioned.
CAREEROS_SUPABASE_DB_PASSWORD=

# AI provider configuration (Gemini) — SERVER ONLY.
CAREEROS_GEMINI_API_KEY=
CAREEROS_GEMINI_MODEL=
