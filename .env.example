# CareerOS AI — shared environment reference
# Copy to .env for local orchestration only. Never commit real values.
# Per-service values live in apps/mobile/.env.example and apps/api/.env.example.

# Which environment the local stack targets: dev | qa | prod
ENVIRONMENT=dev

# Public API origin used by the mobile app (dev default)
PUBLIC_API_URL=http://localhost:8000

# Supabase project reference and public endpoints (public configuration only)
# These are NOT service-role keys. Service-role keys must stay server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
